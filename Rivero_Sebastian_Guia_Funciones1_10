#include <stdio.h>

int producto(int a, int b) {
    if (a <= 0 || b <= 0) {
        printf("Error: Ambos números deben ser enteros positivos.\n");
        return -1; 
    }
    
int resultado = 0;
    for (int i = 0; i < b; i++) {
        resultado += a; 
    }
    
    return resultado;
}
int division(int a, int b) {
    if (a <= 0 || b <= 0) {
        printf("Error: Ambos números deben ser enteros positivos.\n");
        return -1; 
    }
    
    int resultado = 0;
    int acumulador = b; 

    while (acumulador <= a) {
        resultado++;
        acumulador += b; 
    }
    
    return resultado;
}
int main() 
{
    int a, b;
    
    printf("Ingrese dos números enteros positivos: ");
    scanf("%d %d", &a, &b);
    
    int prod = producto(a, b);
    if (prod != -1) {
        printf("El producto de %d y %d es: %d\n", a, b, prod);
    }
    
    int div = division(a, b);
    if (div != -1) {
        printf("La división entera de %d entre %d es: %d\n", a, b, div);
    }
    
    return 0;
}
