#include <stdio.h>

void Letras(int n)
{
    char *unidades[] = {"", "uno", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve"};
    char *decenas[] = {"", "diez", "veinte", "treinta", "cuarenta", "cincuenta", "sesenta", "setenta", "ochenta", "noventa"};
    char *especiales[] = {"diez", "once", "doce", "trece", "catorce", "quince", "dieciseis", "diecisiete", "dieciocho", "diecinueve"};
    char *centenas[] = {"", "cien", "doscientos", "trescientos", "cuatrocientos", "quinientos", "seiscientos", "setecientos", "ochocientos", "novecientos"};

    if(n == 1000)
    {
        printf("mil\n");
        return;
    }

    int c = n / 100;
    int d = (n % 100) / 10;
    int u = n % 10;

    if(c > 0)
    {
        if(c == 1 && (d > 0 || u > 0))
            printf("ciento ");
        else
            printf("%s ", centenas[c]);
    }

    if(d == 1 && u > 0)
    {
        printf("%s\n", especiales[u]);
        return;
    }
    else if(d > 0)
    {
        printf("%s", decenas[d]);
        if(u > 0)
            printf(" y %s", unidades[u]);
        printf("\n");
        return;
    }

    if(u > 0)
        printf("%s\n", unidades[u]);
    else
        printf("\n");
}

int main()
{
    int numero;
    printf("Ingrese un numero entre 1 y 1000: ");
    scanf("%d", &numero);

    if(numero < 1 || numero > 1000)
    {
        printf("Numero fuera de rango\n");
    }
    else
    {
        Letras(numero);
    }

    return 0;
}